# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mercado Pago Checkout Transparente.
# Frontend Vite public key. This value can be exposed in the browser.
VITE_MERCADO_PAGO_PUBLIC_KEY="TEST_PUBLIC_KEY"

# Supabase Edge Function secrets. Never expose these in frontend code.
MERCADO_PAGO_ACCESS_TOKEN="TEST_ACCESS_TOKEN"
MERCADO_PAGO_WEBHOOK_SECRET="MY_MERCADO_PAGO_WEBHOOK_SECRET"
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
